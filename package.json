{
  "name": "surfmind",
  "version": "1.8.1",
  "private": true,
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "eslint": "^8.57.0",
    "lucide-react": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1",
    "uuid": "^10.0.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "prepare": "husky",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "cp node_modules/@mozilla/readability/Readability.js build/readability.js && cp node_modules/@mozilla/readability/LICENSE.md build/readability.LICENSE.md",
    "test": "react-scripts test",
    "lint": "eslint src public/*.js --ignore-pattern 'src/test/**' --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eject": "react-scripts eject",
    "build:ext": "npm run build",
    "package:ext": "bash scripts/package-extension.sh"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "env": {
      "webextensions": true,
      "es2021": true
    },
    "overrides": [
      {
        "files": [
          "public/*.js"
        ],
        "env": {
          "browser": true,
          "worker": true
        },
        "globals": {
          "Readability": "readonly",
          "SurfMindBookmarkSync": "readonly",
          "SurfMindHistorySync": "readonly",
          "SurfMindPageEntries": "readonly",
          "SurfMindStructuredExtraction": "readonly"
        },
        "rules": {
          "no-restricted-globals": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*.{css,html,js,jsx,json,md,yaml,yml}": "prettier --write"
  }
}
