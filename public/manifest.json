{
  "manifest_version": 3,
  "name": "SurfMind - Smarter Browsing",
  "version": "1.80.0",
  "version_name": "1.8.0",
  "minimum_chrome_version": "114",
  "description": "Chrome extension designed to enhance your browsing experience by intelligently managing the websites you visit and bookmark",
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "bookmarks",
    "alarms",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open SurfMind"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "readability.js",
        "structuredExtraction.js",
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "favicon-16x16.png",
    "32": "favicon-32x32.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
